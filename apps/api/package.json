{
  "name": "@apps/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.development node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "node --env-file=.env.production dist/main.js",
    "db:migrate": "node --env-file=.env.development --import=tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env.development --import=tsx src/db/seed.ts",
    "test": "node --env-file=.env.development --import=tsx --import=../../tests/e2e/api-test-env.ts node_modules/vitest/vitest.mjs run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@libs/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.2",
    "argon2": "0.44.0",
    "drizzle-orm": "0.44.7",
    "multer": "2.0.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.4",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
