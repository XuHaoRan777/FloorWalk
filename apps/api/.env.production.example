NODE_ENV=production
PORT=3018
HOST=127.0.0.1
DATABASE_URL=<postgresql-connection-string>
JWT_SECRET=<secret>
STORAGE_DIR=<storage-directory>
API_PUBLIC_BASE_URL=<api-public-base-url>
# 凭据：否；缺失：用默认值；生产环境使用 resend 驱动。
MAIL_DRIVER=resend
# 凭据：否；缺失：启动失败；Resend 发件地址，域名须已在 Resend 验证。
MAIL_FROM_ADDRESS="FloorWalk <no-reply@mail.codexu-studio.com>"
# 凭据：是；缺失：启动失败；真实值只配置在部署密钥存储中。
RESEND_API_KEY=<secret>
# 凭据：否；缺失：启动失败；Resend 验证码模板 ID。
RESEND_TEMPLATE_ID=verification-code
