NODE_ENV=development
PORT=3018
HOST=127.0.0.1
DATABASE_URL=<postgresql-connection-string>
JWT_SECRET=<secret>
STORAGE_DIR=<storage-directory>
API_PUBLIC_BASE_URL=http://127.0.0.1:3018
# 凭据：否；缺失：用默认值；选择 fake 或 resend，默认 fake。
MAIL_DRIVER=fake
# 凭据：否；缺失：启动失败；Resend 发件地址，域名须已在 Resend 验证。
MAIL_FROM_ADDRESS="FloorWalk <no-reply@mail.codexu-studio.com>"
# 凭据：是；缺失：启动失败；仅 MAIL_DRIVER=resend 时使用，真实值留在未跟踪的 .env 文件。
RESEND_API_KEY=<secret>
# 凭据：否；缺失：启动失败；仅 MAIL_DRIVER=resend 时使用的验证码模板 ID。
RESEND_TEMPLATE_ID=verification-code
# AI 审核驱动
# 凭据：否；缺失：用默认值；选择 fake（不发外部请求）或 openai。
AI_REVIEW_DRIVER=fake
