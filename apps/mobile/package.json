    "@gluestack-ui/utils": "5.0.6",
    "@libs/shared": "workspace:*",
    "@tanstack/react-query": "5.90.5",
    "expo": "58.0.24",
    "expo-constants": "58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
