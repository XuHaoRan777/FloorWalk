{
  "name": "@apps/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node --env-file=.env.development node_modules/expo/bin/cli start --localhost",
    "android": "node --env-file=.env.development node_modules/expo/bin/cli start --android --localhost",
    "build": "node --env-file=.env.production node_modules/expo/bin/cli export --platform android --output-dir dist --max-workers 1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "expo install --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "@libs/shared": "workspace:*",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.0.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@expo/metro-config": "57.0.12",
    "@tailwindcss/postcss": "4.2.2",
    "@types/react": "19.2.14",
    "babel-preset-expo": "57.0.13",
    "lightningcss": "1.30.1",
    "postcss": "8.5.6",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.3"
  }
}
